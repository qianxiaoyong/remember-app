{
  "name": "remember-app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.13 <23",
    "pnpm": "10.33.2"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "build:packages": "pnpm --filter @remember/contracts build && pnpm --filter @remember/domain build",
    "typecheck": "pnpm build:packages && pnpm -r --if-present typecheck",
    "test": "node --test tools/checks/check-source.test.mjs && pnpm build:packages && pnpm -r --if-present test",
    "test:contract": "pnpm --filter @remember/contracts test",
    "test:integration": "pnpm build:packages && pnpm -r --if-present test:integration",
    "check:deps": "depcruise --config dependency-cruiser.config.mjs apps packages tools",
    "check:secrets": "secretlint \"**/*\"",
    "check:source": "node tools/checks/check-source.mjs",
    "build": "pnpm -r --if-present build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:contract && pnpm check:deps && pnpm check:secrets && pnpm check:source && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.4",
    "@types/node": "26.1.1",
    "@vitest/eslint-plugin": "1.6.24",
    "dependency-cruiser": "18.1.0",
    "eslint": "10.8.0",
    "globals": "17.7.0",
    "prettier": "3.9.0",
    "secretlint": "13.0.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
