    "content": {
      "lesson": {
        "code": "C1",
        "titleEn": "The Princess and the Pea",
        "titleZh": "公主与豌豆",
        "coverImage": "assets/images/c1.png",
        "primaryAudio": "assets/audio/c1.mp3"
      },
      "story": {
        "paragraphs": [
          {
            "runs": [
              {
                "kind": "text",
                "text": "The prince is "
              },
              {
                "kind": "word",
                "surface": "not",
                "glossZh": "不",
                "tier": "mid",
                "vocabId": "not"
              },
              {
                "kind": "text",
                "text": " "
              },
              {
                "kind": "word",
                "surface": "happy",
                "glossZh": "高兴的；快乐的",
                "tier": "high",
                "vocabId": "happy"
              },
              {
                "kind": "text",
                "text": ". He wants to "
              },
              {
                "kind": "word",
                "surface": "marry",
                "glossZh": "娶；嫁",
                "tier": "low",
                "vocabId": "marry"
              },
              {
                "kind": "text",
                "text": " a princess."
              }
            ],
            "audioStartMs": 0,
            "audioEndMs": 26252,
            "translationZh": "王子并不快乐。他想娶一位公主。"
          },
          {
            "runs": [
              {
                "kind": "text",
                "text": "He "
              },
              {
                "kind": "word",
                "surface": "looks",
                "glossZh": "看；寻找",
                "tier": "high",
                "vocabId": "look"
              },
              {
                "kind": "text",
                "text": " everywhere. He cannot "
              },
              {
                "kind": "word",
                "surface": "find",
                "glossZh": "找到",
                "tier": "high",
                "vocabId": "find"
              },
              {
                "kind": "text",
                "text": " a princess."
              }
            ],
            "audioStartMs": 26252,
            "audioEndMs": 33282,
            "translationZh": "他四处寻找，却找不到一位公主。"
          },
          {
            "runs": [
              {
                "kind": "text",
                "text": "He "
              },
              {
                "kind": "word",
                "surface": "meets",
                "glossZh": "遇见",
                "tier": "mid",
                "vocabId": "meet"
              },
              {
                "kind": "text",
                "text": " "
              },
              {
                "kind": "word",
                "surface": "many",
                "glossZh": "许多",
                "tier": "high",
                "vocabId": "many"
              },
              {
                "kind": "text",
                "text": " princesses. Some are too "
              },
              {
                "kind": "word",
                "surface": "old",
                "glossZh": "老的",
                "tier": "high",
                "vocabId": "old"
              },
              {
                "kind": "text",
                "text": ". Some are too "
              },
              {
                "kind": "word",
                "surface": "small",
                "glossZh": "小的",
                "tier": "high",
                "vocabId": "small"
              },
              {
                "kind": "text",
                "text": " or too "
              },
              {
                "kind": "word",
                "surface": "big",
                "glossZh": "大的",
                "tier": "high",
                "vocabId": "big"
              },
              {
                "kind": "text",
                "text": ". Some are "
              },
              {
                "kind": "word",
                "surface": "not",
                "glossZh": "不",
                "tier": "mid",
                "vocabId": "not"
              },
              {
                "kind": "text",
                "text": " "
              },
              {
                "kind": "word",
                "surface": "beautiful",
                "glossZh": "漂亮的",
                "tier": "mid",
                "vocabId": "beautiful"
              },
              {
                "kind": "text",
                "text": "."
              }
            ],
            "audioStartMs": 33282,
            "audioEndMs": 49179,
            "translationZh": "他遇见了许多公主。有的太老，有的太小或太大，有的也不漂亮。"
          },
          {
            "runs": [
              {
                "kind": "text",
                "text": "One day, a "
              },
              {
                "kind": "word",
                "surface": "girl",
                "glossZh": "女孩",
                "tier": "mid",
                "vocabId": "girl"
              },
              {
                "kind": "text",
                "text": " "
              },
              {
                "kind": "word",
                "surface": "comes",
                "glossZh": "来；来到",
                "tier": "high",
                "vocabId": "come"
              },
              {
                "kind": "text",
                "text": " to his castle. It is "
              },
              {
                "kind": "word",
                "surface": "raining",
                "glossZh": "下雨",
                "tier": "mid",
                "vocabId": "rain"
              },
              {
                "kind": "text",
                "text": "."
              }
            ],
            "audioStartMs": 49179,
            "audioEndMs": 57757,
            "translationZh": "有一天，一个女孩来到他的城堡。外面正下着雨。"
          },
          {
            "runs": [
              {
                "kind": "text",
                "text": "'I'm a princess,' she "
              },
              {
                "kind": "word",
                "surface": "says",
                "glossZh": "说",
                "tier": "high",
                "vocabId": "say"
              },
              {
                "kind": "text",
                "text": ". 'I "
              },
              {
                "kind": "word",
                "surface": "need",
                "glossZh": "需要",
                "tier": "low",
                "vocabId": "need"
              },
              {
                "kind": "text",
                "text": " a "
              },
              {
                "kind": "word",
                "surface": "bed",
                "glossZh": "床",
                "tier": "mid",
                "vocabId": "bed"
              },
              {
                "kind": "text",
                "text": ".'"
              }
            ],
            "audioStartMs": 57757,
            "audioEndMs": 64929,
            "translationZh": "「我是公主，」她说，「我需要一张床。」"
          },
          {
            "runs": [
              {
                "kind": "text",
                "text": "The prince "
              },
              {
                "kind": "word",
                "surface": "likes",
                "glossZh": "喜欢",
                "tier": "high",
                "vocabId": "like"
              },
              {
                "kind": "text",
                "text": " the "
              },
              {
                "kind": "word",
                "surface": "girl",
                "glossZh": "女孩",
                "tier": "mid",
                "vocabId": "girl"
              },
              {
                "kind": "text",
                "text": ". But he does not "
              },
              {
                "kind": "word",
                "surface": "think",
                "glossZh": "想；认为",
                "tier": "high",
                "vocabId": "think"
              },
              {
                "kind": "text",
                "text": " she is a princess."
              }
            ],
            "audioStartMs": 64929,
            "audioEndMs": 75050,
            "translationZh": "王子喜欢这个女孩，但他不认为她是公主。"
          },
          {
            "runs": [
              {
                "kind": "text",
                "text": "He "
              },
              {
                "kind": "word",
                "surface": "has",
                "glossZh": "有",
                "tier": "high",
                "vocabId": "have"
              },
              {
                "kind": "text",
                "text": " an "
              },
              {
                "kind": "word",
                "surface": "idea",
                "glossZh": "主意",
                "tier": "low",
                "vocabId": "idea"
              },
              {
                "kind": "text",
                "text": ". The prince "
              },
              {
                "kind": "word",
                "surface": "makes",
                "glossZh": "做；制作",
                "tier": "high",
                "vocabId": "make"
              },
              {
                "kind": "text",
                "text": " a "
              },
              {
                "kind": "word",
                "surface": "bed",
                "glossZh": "床",
                "tier": "mid",
                "vocabId": "bed"
              },
              {
                "kind": "text",
                "text": " for her. He "
              },
              {
                "kind": "word",
                "surface": "puts",
                "glossZh": "放",
                "tier": "high",
                "vocabId": "put"
              },
              {
                "kind": "text",
                "text": " a pea under 23 mattresses!"
              }
            ],
            "audioStartMs": 75050,
            "audioEndMs": 88806,
            "translationZh": "他有了一个主意。王子为她铺床，还在二十三张床垫下放了一颗豌豆！"
          },
          {
            "runs": [
              {
                "kind": "text",
                "text": "The next morning, the prince "
              },
              {
                "kind": "word",
                "surface": "talks",
                "glossZh": "说话",
                "tier": "mid",
                "vocabId": "talk"
              },
              {
                "kind": "text",
                "text": " to the "
              },
              {
                "kind": "word",
                "surface": "girl",
                "glossZh": "女孩",
                "tier": "mid",
                "vocabId": "girl"
              },
              {
                "kind": "text",
                "text": "."
              }
            ],
            "audioStartMs": 88806,
            "audioEndMs": 95005,
            "translationZh": "第二天早上，王子和这个女孩交谈。"
          },
          {
            "runs": [
              {
                "kind": "text",
                "text": "'I am black and blue,' she "
              },
              {
                "kind": "word",
                "surface": "says",
                "glossZh": "说",
                "tier": "high",
                "vocabId": "say"
              },
              {
                "kind": "text",
                "text": ". 'Your bed is so "
              },
              {
                "kind": "word",
                "surface": "hard",
                "glossZh": "硬的",
                "tier": "mid",
                "vocabId": "hard"
              },
              {
                "kind": "text",
                "text": ".'"
              }
            ],
            "audioStartMs": 95005,
            "audioEndMs": 104274,
            "translationZh": "「我浑身青一块紫一块，」她说，「你的床太硬了。」"
          },
          {
            "runs": [
              {
                "kind": "text",
                "text": "The prince "
              },
              {
                "kind": "word",
                "surface": "thinks",
                "glossZh": "想；认为",
                "tier": "high",
                "vocabId": "think"
              },
              {
                "kind": "text",
                "text": ", '"
              },
              {
                "kind": "word",
                "surface": "Only",
                "glossZh": "只有；仅仅",
                "tier": "high",
                "vocabId": "only"
              },
              {
                "kind": "text",
                "text": " a princess can "
              },
              {
                "kind": "word",
                "surface": "feel",
                "glossZh": "感觉",
                "tier": "mid",
                "vocabId": "feel"
              },
              {
                "kind": "text",
                "text": " the pea under those mattresses!'"
              }
            ],
            "audioStartMs": 104274,
            "audioEndMs": 113580,
            "translationZh": "王子想：「只有公主才能感觉到那些床垫下的豌豆！」"
          },
          {
            "runs": [
              {
                "kind": "text",
                "text": "'"
              },
              {
                "kind": "word",
                "surface": "Only",
                "glossZh": "只有；仅仅",
                "tier": "high",
                "vocabId": "only"
              },
              {
                "kind": "text",
                "text": " a princess is so "
              },
              {
                "kind": "word",
                "surface": "soft",
                "glossZh": "柔软的",
                "tier": "low",
                "vocabId": "soft"
              },
              {
                "kind": "text",
                "text": ".' He "
              },
              {
                "kind": "word",
                "surface": "asks",
                "glossZh": "问",
                "tier": "high",
                "vocabId": "ask"
              },
              {
                "kind": "text",
                "text": ", 'Will you "
              },
              {
                "kind": "word",
                "surface": "marry",
                "glossZh": "娶；嫁",
                "tier": "low",
                "vocabId": "marry"
              },
              {
                "kind": "text",
                "text": " me?'"
              }
            ],
            "audioStartMs": 113580,
            "audioEndMs": 122980,
            "translationZh": "「只有公主才会这么娇贵。」他问道：「你愿意嫁给我吗？」"
          },
          {
            "runs": [
              {
                "kind": "text",
                "text": "The prince and his princess "
              },
              {
                "kind": "word",
                "surface": "take",
                "glossZh": "带；拿",
                "tier": "high",
                "vocabId": "take"
              },
              {
                "kind": "text",
                "text": " the pea to a "
              },
              {
                "kind": "word",
                "surface": "museum",
                "glossZh": "博物馆",
                "tier": "low",
                "vocabId": "museum"
              },
              {
                "kind": "text",
                "text": ". "
              },
              {
                "kind": "word",
                "surface": "Now",
                "glossZh": "现在",
                "tier": "high",
                "vocabId": "now"
              },
              {
                "kind": "text",
                "text": " everyone can see it."
              }
            ],
            "audioStartMs": 122980,
            "audioEndMs": 137561,
            "translationZh": "王子和他的公主把那颗豌豆带到了博物馆。现在所有人都能看见它。"
          }
        ]
      },
