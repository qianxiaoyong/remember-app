# 中心词库补词：local-api 代理 Admin lexicon API 的鉴权
# 复制为 .env 后按需修改（.env 已被 gitignore）

# 方式 A：自动登录（推荐本地开发，可与 apps/api/.env 一致）
LEXICON_ADMIN_LOGIN=admin
LEXICON_ADMIN_PASSWORD=dev-only-admin-password

# 方式 B：直接使用 Admin 登录后的 Bearer token（二选一）
# LEXICON_ADMIN_TOKEN=

# Admin API 地址（默认本机 3000）
LEXICON_API_BASE_URL=http://127.0.0.1:3000
