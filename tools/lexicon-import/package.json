{
  "name": "@remember/lexicon-import",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "remember-lexicon-import": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "import:ecdict": "node dist/cli.js ecdict"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "@remember/contracts": "workspace:*",
    "@remember/domain": "workspace:*",
    "csv-parse": "5.6.0"
  },
  "devDependencies": {
    "@remember/config": "workspace:*",
    "@types/node": "26.1.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "exports": {
    "./import-ecdict": {
      "types": "./dist/import/import-ecdict-batch.d.ts",
      "default": "./dist/import/import-ecdict-batch.js"
    }
  }
}
