# 复制为 apps/api/.env（勿提交 Git）
DATABASE_URL=postgresql://remember:YOUR_PASSWORD@127.0.0.1:5432/remember_dev

# 手机号哈希 pepper；dev/test 可用任意长随机串，禁止与正式环境复用
AUTH_PHONE_PEPPER=dev-only-change-me

# dev/test：固定验证码 000000；production 必须为 false 或未设置
SMS_MOCK_ENABLED=true

# 会话无活动失效天数（测试可缩短，如 0.001 表示约 86 秒）
AUTH_SESSION_TTL_DAYS=90

# 同号重发间隔毫秒（集成测试可设为 0）
# AUTH_SMS_RESEND_INTERVAL_MS=60000

# API 监听端口
PORT=3000

# 兑换码哈希 pepper；dev/test 可用任意长随机串
REDEMPTION_CODE_PEPPER=dev-only-redemption-pepper

# 微信支付 mock（dev/test 默认开启；production 需真实商户配置）
WECHAT_PAY_MOCK_ENABLED=true
# WECHAT_PAY_MCH_ID=
# WECHAT_PAY_MCH_SERIAL=
# WECHAT_PAY_MCH_PRIVATE_KEY_PEM=
# WECHAT_PAY_API_V3_KEY=
# WECHAT_PAY_APP_ID=
# WECHAT_PAY_NOTIFY_URL=

# WECHAT_PAY_MOCK_NOTIFY_SECRET=dev-only-mock-notify-secret

# 包下载 mock（dev/test 默认开启；返回 fixtures 测试 zip）
PACK_DOWNLOAD_MOCK_ENABLED=true
# 下载 token 签名 pepper（必填；勿复用 AUTH_PHONE_PEPPER）
PACK_DOWNLOAD_TOKEN_PEPPER=dev-only-download-pepper
# 生成 downloadUrl 时使用的外网基址（实机联调填局域网 IP）
API_PUBLIC_BASE_URL=http://192.168.10.140:3000
# PACK_DOWNLOAD_MOCK_ZIP_PATH=

# 管理后台会话 TTL（天）
ADMIN_SESSION_TTL_DAYS=7
# dev seed 管理员（勿用于 production）
ADMIN_BOOTSTRAP_LOGIN_NAME=admin
ADMIN_BOOTSTRAP_PASSWORD=dev-only-admin-password

# 管理后台 zip 本地存储目录（dev）
# ADMIN_PACK_STORAGE_DIR=./data/pack-storage

# 目录营销图片本地存储（dev；封面 / introMedia）
# ADMIN_MEDIA_STORAGE_DIR=./data/media
# ADMIN_MEDIA_UPLOAD_MAX_BYTES=5242880
