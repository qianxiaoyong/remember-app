# 复制为 apps/api/.env（勿提交 Git）
DATABASE_URL=postgresql://remember:YOUR_PASSWORD@127.0.0.1:5432/remember_dev

# 手机号哈希 pepper；dev/test 可用任意长随机串，禁止与正式环境复用
AUTH_PHONE_PEPPER=dev-only-change-me

# dev/test：固定验证码 000000；production 必须为 false 或未设置
SMS_MOCK_ENABLED=true

# 会话无活动失效天数（测试可缩短，如 0.001 表示约 86 秒）
AUTH_SESSION_TTL_DAYS=90

# 同号重发间隔毫秒（集成测试可设为 0）
# AUTH_SMS_RESEND_INTERVAL_MS=60000

# API 监听端口
PORT=3000
