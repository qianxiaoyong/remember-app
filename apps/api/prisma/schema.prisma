generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  phoneHash           String               @unique @map("phone_hash")
  maskedPhone         String               @map("masked_phone")
  displayName         String?              @map("display_name")
  mainDeviceId        String?              @map("main_device_id")
  status              String               @default("active")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions            Session[]
  learningStates      LearningState[]
  syncProcessedEvents SyncProcessedEvent[]
  orders              Order[]
  packAccesses        PackAccess[]
  redemptionEvents    RedemptionEvent[]

  @@map("users")
}

model SmsChallenge {
  id           String    @id @default(uuid()) @db.Uuid
  phoneHash    String    @map("phone_hash")
  codeHash     String    @map("code_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  attemptCount Int       @default(0) @map("attempt_count")
  consumedAt   DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([phoneHash, createdAt(sort: Desc)])
  @@map("sms_challenges")
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  userId       String    @map("user_id") @db.Uuid
  deviceId     String    @map("device_id")
  lastActiveAt DateTime  @map("last_active_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model LearningState {
  userId        String   @map("user_id") @db.Uuid
  knowledgeId   String   @map("knowledge_id")
  packId        String   @map("pack_id")
  easiness      Float
  intervalDays  Int      @map("interval_days")
  repetitions   Int
  dueAt         DateTime @map("due_at") @db.Timestamptz(6)
  clientVersion Int      @map("client_version")
  updatedAt     DateTime @map("updated_at") @db.Timestamptz(6)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, knowledgeId])
  @@index([userId])
  @@map("learning_states")
}

model SyncProcessedEvent {
  eventId     String   @id @map("event_id")
  userId      String   @map("user_id") @db.Uuid
  knowledgeId String   @map("knowledge_id")
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sync_processed_events")
}

model CatalogPrimaryNode {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  label     String
  sortOrder Int      @map("sort_order")
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  children  CatalogSecondaryNode[]
  packs     Pack[]

  @@map("catalog_primary_nodes")
}

model CatalogSecondaryNode {
  id        String   @id @default(uuid()) @db.Uuid
  primaryId String   @map("primary_id") @db.Uuid
  slug      String
  label     String
  sortOrder Int      @map("sort_order")
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  primary   CatalogPrimaryNode @relation(fields: [primaryId], references: [id])
  packs     Pack[]

  @@unique([primaryId, slug])
  @@map("catalog_secondary_nodes")
}

model CatalogVersionNode {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  label     String
  sortOrder Int      @map("sort_order")
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  packs     Pack[]

  @@map("catalog_version_nodes")
}

model Pack {
  packId            String        @id @map("pack_id")
  title             String
  displayTitle      String?       @map("display_title")
  primaryCategory   String        @map("primary_category")
  secondaryCategory String        @map("secondary_category")
  versionLabel      String        @map("version_label")
  primaryNodeId     String?       @map("primary_node_id") @db.Uuid
  secondaryNodeId   String?       @map("secondary_node_id") @db.Uuid
  versionNodeId     String?       @map("version_node_id") @db.Uuid
  contentTags       Json          @map("content_tags")
  cardCount         Int           @map("card_count")
  sizeLabel         String        @map("size_label")
  summary           String
  priceCents        Int           @map("price_cents")
  coverUrl          String?       @map("cover_url")
  coverBadge        String?       @map("cover_badge")
  coverLines        Json?         @map("cover_lines")
  includedHighlights Json?        @map("included_highlights")
  samplePreviews    Json          @map("sample_previews")
  introMedia        Json?         @map("intro_media")
  isBundledTestPack Boolean       @default(false) @map("is_bundled_test_pack")
  currentVersionId  String?       @map("current_version_id") @db.Uuid
  status            String        @default("published")
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  primaryNode       CatalogPrimaryNode?   @relation(fields: [primaryNodeId], references: [id])
  secondaryNode     CatalogSecondaryNode? @relation(fields: [secondaryNodeId], references: [id])
  versionNode       CatalogVersionNode?   @relation(fields: [versionNodeId], references: [id])
  versions          PackVersion[]
  orders            Order[]
  packAccesses      PackAccess[]
  redemptionCodes   RedemptionCode[]
  redemptionEvents  RedemptionEvent[]

  @@map("packs")
}

model PackVersion {
  id                String   @id @default(uuid()) @db.Uuid
  packId            String   @map("pack_id")
  packVersion       String   @map("pack_version")
  cosObjectKey      String   @map("cos_object_key")
  sha256            String
  sizeBytes         BigInt   @map("size_bytes")
  keyId             String   @map("key_id")
  manifestSignature String   @map("manifest_signature")
  protocolVersion   Int      @map("protocol_version")
  status            String   @default("published")
  note              String?  @map("note")
  publishedAt       DateTime @map("published_at") @db.Timestamptz(6)
  pack              Pack     @relation(fields: [packId], references: [packId])

  @@unique([packId, packVersion])
  @@map("pack_versions")
}

model Order {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String            @map("user_id") @db.Uuid
  packId           String            @map("pack_id")
  amountCents      Int               @map("amount_cents")
  status           String
  channel          String?
  sourceCode       String?           @map("source_code")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  user             User              @relation(fields: [userId], references: [id])
  pack             Pack              @relation(fields: [packId], references: [packId])
  paymentEvents    PaymentEvent[]
  packAccesses     PackAccess[]
  refunds          Refund[]
  redemptionEvents RedemptionEvent[]

  @@index([userId])
  @@index([packId])
  @@map("orders")
}

model PaymentEvent {
  id             BigInt   @id @default(autoincrement())
  notificationId String   @unique @map("notification_id")
  transactionId  String   @unique @map("transaction_id")
  orderId        String   @map("order_id") @db.Uuid
  processedAt    DateTime @map("processed_at") @db.Timestamptz(6)
  order          Order    @relation(fields: [orderId], references: [id])

  @@map("payment_events")
}

model PackAccess {
  id        BigInt   @id @default(autoincrement())
  userId    String   @map("user_id") @db.Uuid
  packId    String   @map("pack_id")
  orderId   String?  @map("order_id") @db.Uuid
  source    String
  grantedAt DateTime @map("granted_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id])
  pack      Pack     @relation(fields: [packId], references: [packId])
  order     Order?   @relation(fields: [orderId], references: [id])

  @@unique([userId, packId])
  @@map("pack_access")
}

model Refund {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  status    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  order     Order    @relation(fields: [orderId], references: [id])

  @@map("refunds")
}

model RedemptionCode {
  id             String            @id @default(uuid()) @db.Uuid
  codeHash       String            @unique @map("code_hash")
  code           String?           @map("code")
  packId         String            @map("pack_id")
  maxRedemptions Int               @map("max_redemptions")
  redeemedCount  Int               @default(0) @map("redeemed_count")
  expiresAt      DateTime?         @map("expires_at") @db.Timestamptz(6)
  status         String            @default("active")
  note           String?           @map("note")
  deletedAt      DateTime?         @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  pack           Pack              @relation(fields: [packId], references: [packId])
  events         RedemptionEvent[]

  @@map("redemption_codes")
}

model RedemptionEvent {
  id               String         @id @default(uuid()) @db.Uuid
  redemptionCodeId String         @map("redemption_code_id") @db.Uuid
  userId           String         @map("user_id") @db.Uuid
  packId           String         @map("pack_id")
  orderId          String?        @map("order_id") @db.Uuid
  redeemedAt       DateTime       @map("redeemed_at") @db.Timestamptz(6)
  redemptionCode   RedemptionCode @relation(fields: [redemptionCodeId], references: [id])
  user             User           @relation(fields: [userId], references: [id])
  pack             Pack           @relation(fields: [packId], references: [packId])
  order            Order?         @relation(fields: [orderId], references: [id])

  @@index([userId])
  @@map("redemption_events")
}

model AdminUser {
  id              String         @id @default(uuid()) @db.Uuid
  loginName       String         @unique @map("login_name")
  passwordHash    String         @map("password_hash")
  role            String         @default("super_admin")
  status          String         @default("active")
  totpSecret      String?        @map("totp_secret")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions        AdminSession[]
  auditLogs       AuditLog[]
  publishedLemmas ContentLemma[]

  @@map("admin_users")
}

model AdminSession {
  id           String    @id @default(uuid()) @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  adminUserId  String    @map("admin_user_id") @db.Uuid
  lastActiveAt DateTime  @map("last_active_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  adminUser    AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@map("admin_sessions")
}

model AuditLog {
  id                String    @id @default(uuid()) @db.Uuid
  actorAdminUserId  String    @map("actor_admin_user_id") @db.Uuid
  action            String
  targetType        String    @map("target_type")
  targetId          String    @map("target_id")
  payloadSummary    Json      @map("payload_summary")
  result            String
  errorCode         String?   @map("error_code")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  actorAdminUser    AdminUser @relation(fields: [actorAdminUserId], references: [id])

  @@index([createdAt(sort: Desc)])
  @@index([action])
  @@map("audit_logs")
}

model ContentLemma {
  id                   String                  @id @default(uuid()) @db.Uuid
  lemmaKey             String                  @unique @map("lemma_key")
  headword             String
  ipa                  String?
  pos                  String?
  status               String                  @default("draft")
  source               String
  difficultyLevel      Int?                    @map("difficulty_level")
  cefrLevel            String?                 @map("cefr_level")
  frequencyBnc         Int?                    @map("frequency_bnc")
  frequencyFrq         Int?                    @map("frequency_frq")
  collinsStar          Int?                    @map("collins_star")
  oxfordCore           Boolean?                @map("oxford_core")
  importBatchId        String?                 @map("import_batch_id") @db.Uuid
  publishedAt          DateTime?               @map("published_at") @db.Timestamptz(6)
  publishedByAdminId   String?                 @map("published_by_admin_id") @db.Uuid
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  importBatch          ContentImportBatch?     @relation(fields: [importBatchId], references: [id])
  publishedByAdmin     AdminUser?              @relation(fields: [publishedByAdminId], references: [id])
  fragments            ContentLemmaFragment[]
  forms                ContentLemmaForm[]
  assets               ContentLemmaAsset[]
  tagLinks             ContentLemmaTagLink[]

  @@index([status])
  @@index([headword])
  @@map("content_lemmas")
}

model ContentLemmaFragment {
  id           String       @id @default(uuid()) @db.Uuid
  lemmaId      String       @map("lemma_id") @db.Uuid
  fragmentType String       @map("fragment_type")
  content      Json
  sortOrder    Int          @map("sort_order")
  source       String
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  lemma        ContentLemma @relation(fields: [lemmaId], references: [id], onDelete: Cascade)

  @@index([lemmaId, fragmentType])
  @@map("content_lemma_fragments")
}

model ContentLemmaForm {
  formKey     String       @id @map("form_key")
  lemmaId     String       @map("lemma_id") @db.Uuid
  formType    String       @map("form_type")
  displayForm String       @map("display_form")
  source      String
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  lemma       ContentLemma @relation(fields: [lemmaId], references: [id], onDelete: Cascade)

  @@index([lemmaId])
  @@map("content_lemma_forms")
}

model ContentTag {
  id        String                @id @default(uuid()) @db.Uuid
  tagKey    String                @unique @map("tag_key")
  labelZh   String                @map("label_zh")
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  lemmaLinks ContentLemmaTagLink[]

  @@map("content_tags")
}

model ContentLemmaTagLink {
  lemmaId   String       @map("lemma_id") @db.Uuid
  tagId     String       @map("tag_id") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  lemma     ContentLemma @relation(fields: [lemmaId], references: [id], onDelete: Cascade)
  tag       ContentTag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([lemmaId, tagId])
  @@map("content_lemma_tag_links")
}

model ContentImportBatch {
  id             String         @id @default(uuid()) @db.Uuid
  sourceName     String         @map("source_name")
  fileVersion    String         @map("file_version")
  fileSha256     String         @unique @map("file_sha256")
  status         String         @default("running")
  insertedCount  Int            @default(0) @map("inserted_count")
  skippedCount   Int            @default(0) @map("skipped_count")
  errorCount     Int            @default(0) @map("error_count")
  startedAt      DateTime       @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime?      @map("finished_at") @db.Timestamptz(6)
  errorMessage   String?        @map("error_message")
  lemmas         ContentLemma[]

  @@map("content_import_batches")
}

model ContentLemmaAsset {
  id          String       @id @default(uuid()) @db.Uuid
  lemmaId     String       @map("lemma_id") @db.Uuid
  assetKind   String       @map("asset_kind")
  storageKind String       @map("storage_kind")
  pathOrKey   String       @map("path_or_key")
  sha256      String?
  durationMs  Int?         @map("duration_ms")
  mimeType    String?      @map("mime_type")
  voiceId     String?      @map("voice_id")
  ttsText     String?      @map("tts_text")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  lemma       ContentLemma @relation(fields: [lemmaId], references: [id], onDelete: Cascade)

  @@index([lemmaId, assetKind])
  @@map("content_lemma_assets")
}
