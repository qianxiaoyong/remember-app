{
  "expo": {
    "name": "记得",
    "slug": "remember",
    "version": "0.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash-full.png",
      "resizeMode": "cover",
      "backgroundColor": "#F5F6FA"
    },
    "android": {
      "package": "com.remember.app",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-full.png",
          "resizeMode": "cover",
          "backgroundColor": "#F5F6FA"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/with-android-release-signing.js",
      "./plugins/with-android-cleartext-release.js",
      "./plugins/with-android-splash-brand.js",
      "./plugins/with-android-bundle-in-debug.js",
      "expo-audio",
      "expo-secure-store"
    ]
  }
}
