# 复制为 apps/mobile/.env（勿提交 Git）
# 实机联调：填电脑局域网 IP（ipconfig 查看 IPv4），手机与电脑同一 Wi-Fi
# 改 IP 后必须重新打 standalone APK，否则手机仍连旧地址
EXPO_PUBLIC_API_BASE_URL=http://192.168.10.165:3000
# 实机 debug APK 联调 mock 购买（bundle 内 __DEV__ 为 false，需显式开启）
EXPO_PUBLIC_MOCK_PAYMENT_ENABLED=true
# release 联调 mock 购买时还需设为 dev（见 mock-payment-enabled.ts）
EXPO_PUBLIC_APP_VARIANT=dev
